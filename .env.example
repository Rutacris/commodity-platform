# ─────────────────────────────────────────────────────────────────────────────
# Rwanda Commodity Platform — Environment Template
# Copy this to .env and fill in real values. Do NOT commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Rwanda Commodity Price API
APP_VERSION=1.0.0
DEBUG=false

POSTGRES_USER=admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=commodities
DB_HOST=postgres
DB_PORT=5432

OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:7b-instruct-q4

CORS_ORIGINS=*

DOMAIN=your-server-ip-or-domain.com
